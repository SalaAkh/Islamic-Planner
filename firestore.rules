rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow users to read their own profile/premium status
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
    }

    // Make sure users can only read and write their own documents, and only specific allowed data keys
    match /users/{userId}/data/{document} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      // Allow create/update only if it matches our expected document keys
      allow create, update: if request.auth != null 
                             && request.auth.uid == userId
                             && (
                               document == 'goals' || 
                               document == 'board_state' ||
                               document == 'board_drawing' ||
                               document == 'events' ||
                               document == 'todo_lists' ||
                               document == 'boards_meta' ||
                               document == 'mindmap' ||
                               document.matches('^board_state_.*') ||
                               document.matches('^board_drawing_.*') ||
                               document.matches('^day_.*') || 
                               document.matches('^notes_.*')
                             );
    }

    // Activity log — each user can only read/write their own log entries
    match /users/{userId}/activity_log/{logId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Reminders — each user can manage their own reminders
    match /users/{userId}/reminders/{reminderId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // FCM Tokens for Push Notifications
    match /users/{userId}/fcmTokens/{tokenId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ─── NEW: Group Workspaces ───
    match /groups/{groupId} {
      // Any authenticated user can create a group
      allow create: if request.auth != null
                    && request.resource.data.createdBy == request.auth.uid;
      
      // Read: any member or creator
      allow read: if request.auth != null && 
        (resource.data.members.hasAny([request.auth.token.email]) || resource.data.createdBy == request.auth.uid);
      
      // Update: member or creator, but createdBy field cannot be changed
      allow update: if request.auth != null && 
        (resource.data.members.hasAny([request.auth.token.email]) || resource.data.createdBy == request.auth.uid)
        && request.resource.data.createdBy == resource.data.createdBy;
      
      // Delete: ONLY the creator can delete a group
      allow delete: if request.auth != null && resource.data.createdBy == request.auth.uid;

      // Access to nested collections (board, events, lists)
      match /data/{document} {
        allow read: if request.auth != null && 
          get(/databases/$(database)/documents/groups/$(groupId)).data.members.hasAny([request.auth.token.email]);
        // Write: members only, with document name validation
        allow write: if request.auth != null && 
          get(/databases/$(database)/documents/groups/$(groupId)).data.members.hasAny([request.auth.token.email])
          && (
            document == 'goals' || 
            document == 'board_state' ||
            document == 'board_drawing' ||
            document == 'events' ||
            document == 'todo_lists' ||
            document == 'boards_meta' ||
            document == 'mindmap' ||
            document.matches('^board_state_.*') ||
            document.matches('^board_drawing_.*') ||
            document.matches('^day_.*') || 
            document.matches('^notes_.*')
          );
      }
    }
  }
}
