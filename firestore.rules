rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ─── System logs — server-only, no client access ───
    match /system_logs/{logId} {
      allow read, write: if false;
    }

    // Allow users to read their own profile/premium status, and write specifically for trial activation
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null 
                             && request.auth.uid == userId 
                             && (
                               (!exists(/databases/$(database)/documents/users/$(userId)) || !resource.data.hasUsedTrial)
                               && request.resource.data.hasUsedTrial == true
                               && request.resource.data.isPremium == true
                               && request.resource.data.premiumPlan == 'trial'
                               && request.resource.data.trialCardHash != null
                               && get(/databases/$(database)/documents/used_cards/$(request.resource.data.trialCardHash)).data.userId == request.auth.uid
                             );
    }

    // Used cards registry for trial period (one card per trial)
    // Read restricted to own cards only to prevent hash enumeration
    match /used_cards/{cardHash} {
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null 
                    && !exists(/databases/$(database)/documents/used_cards/$(cardHash))
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }


    // Make sure users can only read and write their own documents, and only specific allowed data keys
    match /users/{userId}/data/{document} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      // Allow create/update only if it matches our expected document keys
      allow create, update: if request.auth != null 
                             && request.auth.uid == userId
                             && (
                               document == 'goals' || 
                               document == 'board_state' ||
                               document == 'user_stats' ||
                               document == 'board_drawing' ||
                               document == 'events' ||
                               document == 'todo_lists' ||
                               document == 'boards_meta' ||
                               document == 'mindmap' ||
                               document.matches('^board_state_.*') ||
                               document.matches('^board_drawing_.*') ||
                               document.matches('^day_.*') || 
                               document.matches('^notes_.*')
                             );
    }

    // AI usage — read-only by owner, write restricted to server (Cloud Functions)
    match /users/{userId}/ai_usage/{dateId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Activity log — each user can only read/write their own log entries
    match /users/{userId}/activity_log/{logId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Reminders — each user can manage their own reminders
    match /users/{userId}/reminders/{reminderId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // FCM Tokens for Push Notifications
    match /users/{userId}/fcmTokens/{tokenId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ─── Group Workspaces ───
    match /groups/{groupId} {
      // Any authenticated user can create a group
      allow create: if request.auth != null
                    && request.resource.data.createdBy == request.auth.uid;
      
      // Read: any member or creator
      allow read: if request.auth != null && 
        (resource.data.members.hasAny([request.auth.token.email]) || resource.data.createdBy == request.auth.uid);
      
      // Update: only creator can change members list; other members can update non-membership fields
      allow update: if request.auth != null
        && request.resource.data.createdBy == resource.data.createdBy
        && (
          // Creator can update anything
          resource.data.createdBy == request.auth.uid
          ||
          // Members can update, but CANNOT change the members array
          (resource.data.members.hasAny([request.auth.token.email])
           && request.resource.data.members == resource.data.members)
        );
      
      // Delete: ONLY the creator can delete a group
      allow delete: if request.auth != null && resource.data.createdBy == request.auth.uid;

      // Access to nested collections (board, events, lists)
      match /data/{document} {
        allow read: if request.auth != null && 
          get(/databases/$(database)/documents/groups/$(groupId)).data.members.hasAny([request.auth.token.email]);
        // Write: members only, with document name validation
        allow write: if request.auth != null && 
          get(/databases/$(database)/documents/groups/$(groupId)).data.members.hasAny([request.auth.token.email])
          && (
            document == 'goals' || 
            document == 'board_state' ||
            document == 'board_drawing' ||
            document == 'events' ||
            document == 'todo_lists' ||
            document == 'boards_meta' ||
            document == 'mindmap' ||
            document.matches('^board_state_.*') ||
            document.matches('^board_drawing_.*') ||
            document.matches('^day_.*') || 
            document.matches('^notes_.*')
          );
      }
    }
  }
}
